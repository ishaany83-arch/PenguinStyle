# Fly.io environment variables
PORT=3000
NODE_ENV=production

# Rate limiting (requests per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Proxy settings
PROXY_TIMEOUT=30000
PROXY_SIZE_LIMIT=10mb

# Security - Blocked hosts (comma-separated)
BLOCKED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Whitelist - Only allow these domains (comma-separated)
# Leave empty to allow all domains
ALLOWED_HOSTS=roblox.com,y8.com,coolmathgames.com,now.gg,youtube.com,scratch.mit.edu

# CORS settings
ALLOWED_ORIGINS=*

# Frontend config (for public/config.js)
REACT_APP_API_URL=https://your-fly-app.fly.dev
